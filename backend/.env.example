APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# First-party SPA origins and hosts
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# B2-S0 B1 validation adapter
B1_PYTHON_BIN=python
B1_SCRIPT_PATH=../research/phase-13.3/annotation_pipeline_step8b/scripts/validate_step8b_records.py
B1_SCHEMA_PATH=../research/phase-13.3/annotation_pipeline_step8a/config/human_recognition.schema.json
B1_INVENTORY_PATH=../research/phase-13.3/annotation_pipeline/exports/master_image_inventory.csv
B1_TAXONOMY_PATH=../research/phase-13.3/annotation_pipeline/config/approved_taxonomy.json
B1_DECISIONS_PATH=../research/phase-13.3/annotation_pipeline_step8a/config/label_mapping_decisions.json
B1_TIMEOUT_SECONDS=60
B1_BATCH_TIMEOUT_SECONDS=300
B1_WORKDIR=..
B1_TEMP_DIR=storage/app/b1-validation

# B2-S1 read-only registry endpoints (server-controlled; metadata only)
ANNOTATION_REGISTRY_TAXONOMY_PATH=
ANNOTATION_REGISTRY_INVENTORY_PATH=
ANNOTATION_REGISTRY_DECISIONS_PATH=
ANNOTATION_REGISTRY_IMAGE_ID_REGISTRY_PATH=../research/phase-13.3/annotation_pipeline/config/image_id_registry.json
ANNOTATION_REGISTRY_CACHE_TTL_SECONDS=30
